# Runtime artifacts - regenerated on every agent.sh run, not source
output/*
logs/*
.agent.lock
.server_id
.agent.update.lock/

# Windows runtime artifacts - independent of the Linux runtime paths
windows/output/*
windows/logs/*
windows/.agent.lock
windows/config/agent.local.psd1

# Local secrets and deployment configuration
.env

# Graphify code-graph artifacts (regenerate with `graphify extract . --code-only`)
graphify-out/
